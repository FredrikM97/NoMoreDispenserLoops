<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>NoMoreDispenserLoops</AssemblyName>
    <RootNamespace>NoMoreDispenserLoops</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PLib" Version="4.26.0" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony.Ref" Version="2.4.3" ExcludeAssets="compile;runtime" PrivateAssets="all" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.48" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(GameManagedDir)/Assembly-CSharp.dll" Private="false" Condition="Exists('$(GameManagedDir)/Assembly-CSharp.dll')" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(GameManagedDir)/Assembly-CSharp-firstpass.dll" Private="false" Condition="Exists('$(GameManagedDir)/Assembly-CSharp-firstpass.dll')" />
    <Reference Include="0Harmony" HintPath="$(GameManagedDir)/0Harmony.dll" Private="false" Condition="Exists('$(GameManagedDir)/0Harmony.dll')" />
    <Reference Include="UnityEngine" HintPath="$(GameManagedDir)/UnityEngine.dll" Private="false" Condition="Exists('$(GameManagedDir)/UnityEngine.dll')" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManagedDir)/UnityEngine.CoreModule.dll" Private="false" Condition="Exists('$(GameManagedDir)/UnityEngine.CoreModule.dll')" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameManagedDir)/UnityEngine.UI.dll" Private="false" Condition="Exists('$(GameManagedDir)/UnityEngine.UI.dll')" />
    <Reference Include="Newtonsoft.Json" HintPath="$(GameManagedDir)/Newtonsoft.Json.dll" Private="false" Condition="Exists('$(GameManagedDir)/Newtonsoft.Json.dll')" />
  </ItemGroup>

  <Target Name="ValidateGameAssemblies" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameManagedDir)/Assembly-CSharp.dll')" Text="ONI Managed assemblies not found. Set ONI_MANAGED_DIR to OxygenNotIncluded_Data/Managed or copy the required DLLs into lib/." />
    <Error Condition="!Exists('$(GameManagedDir)/Assembly-CSharp-firstpass.dll')" Text="Assembly-CSharp-firstpass.dll not found in $(GameManagedDir)." />
    <Error Condition="!Exists('$(GameManagedDir)/0Harmony.dll')" Text="0Harmony.dll not found in $(GameManagedDir)." />
    <Error Condition="!Exists('$(GameManagedDir)/UnityEngine.dll')" Text="UnityEngine.dll not found in $(GameManagedDir)." />
    <Error Condition="!Exists('$(GameManagedDir)/UnityEngine.CoreModule.dll')" Text="UnityEngine.CoreModule.dll not found in $(GameManagedDir)." />
    <Error Condition="!Exists('$(GameManagedDir)/UnityEngine.UI.dll')" Text="UnityEngine.UI.dll not found in $(GameManagedDir)." />
    <Error Condition="!Exists('$(GameManagedDir)/Newtonsoft.Json.dll')" Text="Newtonsoft.Json.dll not found in $(GameManagedDir)." />
  </Target>

  <Target Name="CopyModToOutput" AfterTargets="MergePLib">
    <MakeDir Directories="$(ModOutputDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModOutputDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/mod.yaml;$(MSBuildProjectDirectory)/mod_info.yaml;$(MSBuildProjectDirectory)/../../README.md" DestinationFolder="$(ModOutputDir)" />
  </Target>
</Project>
